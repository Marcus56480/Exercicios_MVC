@model List<Evento>
@{
    ViewData["Title"] = "Lista de Eventos Cadastrados";
}

<h1>Eventos Cadastrados</h1>

<table>
    <tr>
        <th>Id</th>
        <th>Nome</th>
        <th>Descrição</th>
        <th>Local</th>
        <th>Data do Evento</th>
        <th>Quantidade de Vagas</th>
        <th>Valor do Ingresso</th>
        <th></th>
    </tr>

    @foreach(Evento evento in Model)
    {
        <tr>
            <td>@evento.Id</td>
            <td>@evento.Nome</td>
            <td>@evento.Descricao</td>
            <td>@evento.Local</td>
            <td>@evento.DataEvento</td>
            <td>@evento.QuantidadeVagas</td>
            <td>@evento.ValorIngresso</td>

            <td>
                <a asp-action="Detalhes" asp-route-id="@evento.Id">Detalhes</a>
            </td>
        </tr>
    }
</table>
@using Exercicios_MVC.ViemModels
@model BuscaEventoViewModels

@{
    ViewData["Title"] = "Buscar Evento";
}

<h1>Buscar Alunos</h1>

<form asp-action="Buscar" method="post">
    <input asp-for="NomeBusca" type="text" placeholder="Digite o Nome do Evento">
    <button type="submit">Buscar</button>
</form>

<form asp-action="Buscar" method="post">
    <input asp-for="LocalBusca" type="text" placeholder="Digite o Nome do Local do Evento">
    <button type="submit">Buscar</button>
</form>

@if (Model.Resultados.Any())
{
    <table>
        <tr>
            <th>Id</th>
            <th>Nome</th>
            <th>Descrição</th>
            <th>Local</th>
            <th>Data do Evento</th>
            <th>Quantidade de Vagas</th>
            <th>Valor do Ingresso</th>
        </tr>
        
        @foreach (Evento evento in Model.Resultados)
        {
            <tr>
                <td>@evento.Id</td>
                <td>@evento.Nome</td>
                <td>@evento.Descricao</td>
                <td>@evento.Local</td>
                <td>@evento.DataEvento</td>
                <td>@evento.QuantidadeVagas</td>
                <td>@evento.ValorIngresso</td>
            </tr>
        }
    </table>
}